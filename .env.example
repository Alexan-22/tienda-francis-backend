# Configurar por proceso. Spring Boot NO carga .env automáticamente.
DB_URL=jdbc:postgresql://localhost:5432/tienda_auth_db
DB_USERNAME=postgres
DB_PASSWORD=CAMBIAR
JWT_SECRET=GENERAR_SECRETO_ALEATORIO_DE_MAS_DE_32_BYTES
JWT_ISSUER=tienda-francis
JWT_EXPIRATION_SECONDS=3600
INTERNAL_API_KEY=GENERAR_OTRO_SECRETO
EUREKA_SERVER_URL=http://localhost:8761/eureka/
AUTH_INTERNAL_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
STOCK_RESERVATION_TTL_SECONDS=900
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Delivery (solo comercio-service): establecer tarifas reales aprobadas antes de aceptar pedidos.
# Sintaxis: DEPARTAMENTO|PROVINCIA|DISTRITO=PRECIO;...
DELIVERY_TARIFFS=
STOCK_EXPIRATION_SCAN_MS=60000
